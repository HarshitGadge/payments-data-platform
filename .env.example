# Copy to .env and fill in. Compose refuses to start if any of these is unset,
# so the stack never comes up on a default password.
POSTGRES_USER=payments
POSTGRES_PASSWORD=
# LocalStack accepts any credentials; real S3 needs real ones.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Batch warehouse (only needed for the Snowflake path)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PAYMENTS
